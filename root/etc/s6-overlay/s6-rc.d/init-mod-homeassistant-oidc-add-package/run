#!/usr/bin/with-contenv bash

## Ubuntu
if [ -f /usr/bin/apt ]; then
    echo "\
        sed \
        curl \
        git \
        jq \
        yq" >> /mod-repo-packages-to-install.list

fi
# Alpine
if [ -f /sbin/apk ]; then
    echo "\
        sed \
        curl \
        git \
        jq \
        yq" >> /mod-repo-packages-to-install.list
fi
#!/usr/bin/with-contenv bash

### homeassistant-oidc v1.0.0 ###

# This is an install script that is designed to run after init-mods-package-install
# so it can take advantage of packages installed
# init-mods-end depends on this script so that later init and services wait until this script exits

echo "**** Setting up OIDC-Connection ****"

if [[ -n "${OIDC_CLIENT_ID}" ]]; then
    echo "**** Download and Set up OpenID ****"
    if [ ! -d "/config/custom_components/auth_oidc" ]; then    
        git clone https://github.com/christiaangoossens/hass-oidc-auth.git
        mkdir -p /config/custom_components/
        mv hass-oidc-auth/custom_components/auth_oidc /config/custom_components/
        rm -R hass-oidc-auth
    fi
    yq -i -r=false '.auth_oidc.client_id = strenv(OIDC_CLIENT_ID)
        | .auth_oidc.client_id style="double"
        | .auth_oidc.client_id line_comment="OIDC_CLIENT_ID"
        | .auth_oidc.discovery_url = strenv(OIDC_CONFIGURE_URL)
        | .auth_oidc.discovery_url style="double"
        | .auth_oidc.discovery_url line_comment="OIDC_CONFIGURE_URL"
        | .auth_oidc.display_name = strenv(OIDC_OPENID_TEXT)
        | .auth_oidc.display_name style="double"
        | .auth_oidc.display_name line_comment="OIDC_OPENID_TEXT"
        | .auth_oidc.network.tls_verify = env(OIDC_VALIDATE_TLS)
        | .auth_oidc.network.tls_verify line_comment="OIDC_VALIDATE_TLS"
        | .auth_oidc.network.tls_verify = env(OIDC_VALIDATE_TLS)
        | .auth_oidc.network.tls_verify line_comment="OIDC_VALIDATE_TLS"
        | .auth_oidc.claims.username = strenv(OIDC_USERNAME_FIELD)
        | .auth_oidc.claims.username style="double"
        | .auth_oidc.claims.username line_comment="OIDC_USERNAME_FIELD"
        | .auth_oidc.claims.display_name = strenv(OIDC_DISPLAY_NAME)
        | .auth_oidc.claims.display_name style="double"
        | .auth_oidc.claims.display_name line_comment="OIDC_DISPLAY_NAME"
        | .auth_oidc.features.default_redirect = env(OIDC_BLOCK_LOGIN)
        | .auth_oidc.features.default_redirect line_comment="OIDC_BLOCK_LOGIN"
        | .auth_oidc.features.automatic_person_creation = env(OIDC_CREATE_USER)
        | .auth_oidc.features.automatic_person_creation line_comment="OIDC_CREATE_USER"
     ' /config/configuration.yaml
fi
#!/usr/bin/with-contenv bash

### homeassistant-oidc v2.0.2 ###

# Changelog:
# v2.0.2
# - force version, update files if version does not match
# v2.0.1
# - fix css (download release zip instead of git clone master repo)
# v2.0.0
# - switch to christiangoosens version, as this one supports automatic setup (secret-less)
# - update all keys to support new cosmos template with automatic oidc-setup (Cosmos v.0.22.30+)

# This is an install script that is designed to run after init-mods-package-install
# so it can take advantage of packages installed
# init-mods-end depends on this script so that later init and services wait until this script exits

echo "**** Setting up OIDC-Connection ****"

if [[ -n "${OIDC_CLIENT_ID}" ]]; then
    echo "**** Download and Set up OpenID ****"
    version="1.1.1"
    if [ ! -d "/config/custom_components/auth_oidc" ] || [ "${version}" != "$(yq '.version' /config/custom_components/auth_oidc/manifest.json --output-format t)" ]; then    
        wget -O auth_oidc.zip "https://github.com/christiaangoossens/hass-oidc-auth/releases/download/v${version}/hass-oidc-auth.zip"
        rm -R /config/custom_components/auth_oidc
        mkdir -p /config/custom_components/auth_oidc
        unzip auth_oidc.zip -d /config/custom_components/auth_oidc
        rm auth_oidc.zip
    fi
    yq -i -r=false '.auth_oidc.client_id = strenv(OIDC_CLIENT_ID)
        | .auth_oidc.client_id style="double"
        | .auth_oidc.client_id line_comment="OIDC_CLIENT_ID"
        | .auth_oidc.display_name = strenv(OIDC_CLIENT_NAME)
        | .auth_oidc.display_name style="double"
        | .auth_oidc.display_name line_comment="OIDC_CLIENT_NAME"
        | .auth_oidc.discovery_url = strenv(OIDC_DISCOVERY_URL)
        | .auth_oidc.discovery_url style="double"
        | .auth_oidc.discovery_url line_comment="OIDC_DISCOVERY_URL"
        | .auth_oidc.network.tls_verify = env(OIDC_VALIDATE_TLS)
        | .auth_oidc.network.tls_verify line_comment="OIDC_VALIDATE_TLS"
        | .auth_oidc.network.tls_verify = env(OIDC_VALIDATE_TLS)
        | .auth_oidc.network.tls_verify line_comment="OIDC_VALIDATE_TLS"
        | .auth_oidc.features.automatic_user_linking = env(OIDC_LINK_USER)
        | .auth_oidc.features.automatic_user_linking line_comment="OIDC_LINK_USER"
        | .auth_oidc.features.automatic_person_creation = env(OIDC_CREATE_USER)
        | .auth_oidc.features.automatic_person_creation line_comment="OIDC_CREATE_USER"
        | .auth_oidc.features.default_redirect = env(OIDC_BLOCK_LOGIN)
        | .auth_oidc.features.default_redirect line_comment="OIDC_BLOCK_LOGIN"
        | .auth_oidc.claims.username = strenv(OIDC_USERNAME_FIELD)
        | .auth_oidc.claims.username style="double"
        | .auth_oidc.claims.username line_comment="OIDC_USERNAME_FIELD"
        | .auth_oidc.claims.display_name = strenv(OIDC_DISPLAYNAME_FIELD)
        | .auth_oidc.claims.display_name style="double"
        | .auth_oidc.claims.display_name line_comment="OIDC_DISPLAYNAME_FIELD"
        | .auth_oidc.claims.groups = strenv(OIDC_GROUPS_FIELD)
        | .auth_oidc.claims.groups style="double"
        | .auth_oidc.claims.groups line_comment="OIDC_GROUPS_FIELD"
        | .auth_oidc.groups_scope = strenv(OIDC_GROUPS_SCOPE)
        | .auth_oidc.groups_scope style="double"
        | .auth_oidc.groups_scope line_comment="OIDC_GROUPS_SCOPE"
        | .auth_oidc.roles.admin = strenv(OIDC_ADMIN_NAME)
        | .auth_oidc.roles.admin style="double"
        | .auth_oidc.roles.admin line_comment="OIDC_ADMIN_NAME"
     ' /config/configuration.yaml
fi